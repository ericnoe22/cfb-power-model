# Secrets / environment
.env
.env.local

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Cache (runtime-generated, not part of source)
# Keep the directory itself + key preseason data files needed on Streamlit Cloud
cache/*
!cache/.gitkeep
!cache/sp_plus_2026.csv
!cache/sp_plus_2026_spring.csv
!cache/fpi_2026.csv
!cache/fpi_projections_2026.csv
!cache/elo_current.csv
!cache/sagarin_2026.json
!cache/team_intel_2026.json
!cache/lines_live.csv

# Streamlit: keep config.toml (theme), exclude secrets
.streamlit/secrets.toml

# Outputs — keep backtest CSVs, ignore calibration/ratings exports
outputs/*
!outputs/backtest_*.csv

# Large raw data / one-off analysis files
2024_box_scores.json
elo_2024.csv
lines_2024*.csv
lines_2025_fbs_only.csv
games_with_*.csv
ats_trends_2024.csv
ncf_betting_trends_2024.xlsx
CFB lines*.csv
clean_week1_ou.csv
cleaned_week1_spreads.csv
logs/

